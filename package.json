{
  "name": "eevee-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A durable workspace that people and browser agents use together through WebMCP.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=10"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GLDRoger/eevee-mcp.git"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "node --env-file-if-exists=.env.local src/server/db/migrate.ts",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.3.3",
    "parse5": "8.0.1",
    "postgres": "3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.3",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
